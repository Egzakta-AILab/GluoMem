# Copy to .env (gitignored). Loaded into os.environ by load_config()
# (real environment variables always win over this file).
# Required: choose a name in your model registry; no generation model is selected for you.
GLUOMEM_DSPY__MODEL=

# Total transient extraction attempts, including the first; 1 disables automatic retries.
GLUOMEM_DSPY__RETRY__MAX_ATTEMPTS=1
GLUOMEM_DSPY__RETRY__INITIAL_DELAY_SECONDS=1
GLUOMEM_DSPY__RETRY__MAX_DELAY_SECONDS=30

# Only needed if your explicitly selected model uses OpenRouter.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
