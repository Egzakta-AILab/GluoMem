{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "gluomem hook recall --url ${GLUOMEM_URL:-http://127.0.0.1:8080} --tenant-id ${GLUOMEM_TENANT_ID:-local} --principal-id ${GLUOMEM_PRINCIPAL_ID:-default} --namespace ${GLUOMEM_NAMESPACE:-openclaw}",
        "timeout_ms": 1500
      }
    ],
    "stop": [
      {
        "command": "gluomem hook capture --async --url ${GLUOMEM_URL:-http://127.0.0.1:8080} --tenant-id ${GLUOMEM_TENANT_ID:-local} --principal-id ${GLUOMEM_PRINCIPAL_ID:-default} --namespace ${GLUOMEM_NAMESPACE:-openclaw}",
        "timeout_ms": 2000
      }
    ]
  }
}
